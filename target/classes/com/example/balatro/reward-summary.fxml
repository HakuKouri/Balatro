<AnchorPane style="-fx-border-color: #233; -fx-border-width: 3;" stylesheets="@../../css/style.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.balatro.controller.RewardSummaryController">
   <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <columnConstraints>
         <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" percentWidth="80.0" />
         <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints percentHeight="18.7" vgrow="SOMETIMES" />
         <RowConstraints vgrow="SOMETIMES" />
      </rowConstraints>
      <children>
         <Button fx:id="cashOut_Button" mnemonicParsing="false" onAction="#cashOut" prefHeight="63.0" prefWidth="476.0" style="-fx-background-color: #B06500; -fx-background-radius: 10; -fx-border-color: #fff; -fx-border-radius: 10; -fx-border-width: 3;" text="Cash Out: $..." textFill="WHITE" GridPane.columnIndex="1">
            <font>
               <Font name="balatro Regular" size="29.0" />
            </font>
         </Button>
