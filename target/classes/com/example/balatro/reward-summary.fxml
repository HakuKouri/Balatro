                              </padding>
                           </Separator>
                        </children>
                     </VBox>
                  </children>
                  <padding>
                     <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                  </padding>
               </AnchorPane>
           </content>
         </ScrollPane>
      </children>
      <styleClass>
         <String fx:value="background-dark" />
         <String fx:value="bgr-10" />
      </styleClass>
   </GridPane>
   <styleClass>
      <String fx:value="background-light" />
      <String fx:value="bgr-20" />
      <String fx:value="br-20" />
