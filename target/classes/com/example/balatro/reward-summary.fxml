             <AnchorPane>
                  <children>
                     <VBox fx:id="rewardVBox" layoutX="15.0" layoutY="15.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <children>
                           <GridPane fx:id="blindRewardPane" prefHeight="60.0">
                              <columnConstraints>
                                 <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="-Infinity" percentWidth="10.0" />
                                 <ColumnConstraints hgrow="SOMETIMES" percentWidth="20.0" />
                                 <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" />
                              </columnConstraints>
                              <rowConstraints>
                                 <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                 <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              </rowConstraints>
                              <ImageView fx:id="rewardBlindChip" fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true" GridPane.rowSpan="2" />
                              <AnchorPane GridPane.columnIndex="1">
                                 <children>
                                    <Label alignment="CENTER" text="Score at least:" textFill="WHITE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                       <font>
                                          <Font name="balatro Regular" size="15.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </AnchorPane>
                              <HBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <ImageView fx:id="rewardBlindStake" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />
                                 <Label fx:id="rewardBlindScore" prefHeight="39.0" prefWidth="199.0" text="Label" textFill="RED">
                                    <font>
                                       <Font name="balatro Regular" size="20.0" />
                                    </font>
                                 </Label>
                              </HBox>
                              <Label fx:id="rewardBlindReward" alignment="CENTER_RIGHT" contentDisplay="RIGHT" prefHeight="40.0" prefWidth="157.0" text="\$$$" textFill="#f8b73e" GridPane.columnIndex="2" GridPane.rowSpan="2">
                                 <font>
                                    <Font name="balatro Regular" size="28.0" />
                                 </font>
                              </Label>
