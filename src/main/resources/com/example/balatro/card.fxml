<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="card_AnchorPane" maxHeight="219.0" maxWidth="165.0" prefHeight="219.0" prefWidth="165.0" style="-fx-background-color: transparent;" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.balatro.controller.CardViewController">
    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <AnchorPane fx:id="price_AnchorPane" maxHeight="60.0" maxWidth="93.0" StackPane.alignment="TOP_CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <styleClass>
                <String fx:value="background-dark" />
                <String fx:value="bgr-t-20" />
            </styleClass>
            <StackPane.margin>
                <Insets top="-40.0" />
            </StackPane.margin>
            <Label fx:id="priceLabel" alignment="CENTER" style="-fx-font-size: 14; -fx-text-fill: gold;" text="\$..." AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <styleClass>
                    <String fx:value="background-light" />
                    <String fx:value="bgr-10" />
                </styleClass>
            </Label>
        </AnchorPane>
        <AnchorPane fx:id="buy_AnchorPane" maxHeight="100.0" maxWidth="93.0" StackPane.alignment="BOTTOM_CENTER">
            <styleClass>
                <String fx:value="buy-background" />
                <String fx:value="bgr-b-20" />
            </styleClass>
            <StackPane.margin>
                <Insets bottom="-70.0" />
            </StackPane.margin>
            <Label fx:id="buyLabel" alignment="CENTER" text="BUY" textFill="WHITE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
        </AnchorPane>
      <AnchorPane fx:id="useSelect_AnchorPane" maxHeight="100.0" maxWidth="93.0" StackPane.alignment="BOTTOM_CENTER">
         <styleClass>
            <String fx:value="sell-background" />
            <String fx:value="bgr-b-20" />
         </styleClass>
         <children>
            <Label fx:id="useSelect_Label" alignment="CENTER" text="SELECT" textFill="WHITE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
         <StackPane.margin>
            <Insets bottom="-70.0" />
         </StackPane.margin>
      </AnchorPane>
      <AnchorPane StackPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_RIGHT" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                    <AnchorPane fx:id="buyUseSell_AnchorPane" maxHeight="84.0" maxWidth="87.0" minHeight="80.0">
                        <styleClass>
                            <String fx:value="sell-background" />
                            <String fx:value="bgr-r-20" />
                        </styleClass>
                        <Label fx:id="buyUseSell_Label" alignment="CENTER_RIGHT" text="Buy Use Sell" textFill="WHITE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </AnchorPane>
                  <AnchorPane fx:id="use_AnchorPane" maxHeight="84.0" maxWidth="87.0" minHeight="60.0">
                     <styleClass>
                        <String fx:value="sell-background" />
                        <String fx:value="bgr-r-20" />
                     </styleClass>
                     <children>
                        <Label fx:id="use_Label" alignment="CENTER_RIGHT" text="Use" textFill="WHITE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
               </children>
               <padding>
                  <Insets right="-67.0" />
               </padding>
            </VBox>
         </children>
      </AnchorPane>
        <StackPane fx:id="image_StackPane">
            <ImageView fx:id="cardImage" fitHeight="219.0" fitWidth="165.0" StackPane.alignment="CENTER" />
        </StackPane>
    </StackPane>
   <AnchorPane fx:id="toolTipHoverPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
</AnchorPane>
