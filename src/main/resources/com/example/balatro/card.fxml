<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="card_AnchorPane" maxHeight="219.0" maxWidth="165.0" prefHeight="219.0" prefWidth="165.0" style="-fx-background-color: transparent; -fx-border-color: #f00; -fx-border-width: 5;" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.balatro.controller.CardViewController">
    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0">
        <AnchorPane fx:id="price_AnchorPane" maxHeight="60.0" maxWidth="93.0" StackPane.alignment="TOP_CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="5.0"/>
            </padding>
            <styleClass>
                <String fx:value="background-dark"/>
                <String fx:value="bgr-t-20"/>
            </styleClass>
            <StackPane.margin>
                <Insets top="-40.0"/>
            </StackPane.margin>
            <Label fx:id="priceLabel" alignment="CENTER" style="-fx-font-size: 14; -fx-text-fill: gold;"
                   text="\$..." AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <styleClass>
                    <String fx:value="background-light"/>
                    <String fx:value="bgr-10"/>
                </styleClass>
            </Label>
        </AnchorPane>
        <AnchorPane fx:id="buy_AnchorPane" maxHeight="100.0" maxWidth="93.0" StackPane.alignment="BOTTOM_CENTER">
            <styleClass>
                <String fx:value="buy-background"/>
                <String fx:value="bgr-b-20"/>
            </styleClass>
            <StackPane.margin>
                <Insets bottom="-70.0"/>
            </StackPane.margin>
            <Label fx:id="buyLabel" alignment="CENTER" text="BUY" textFill="WHITE" AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        </AnchorPane>
        <AnchorPane fx:id="sell_AnchorPane" maxHeight="84.0" maxWidth="87.0" StackPane.alignment="CENTER_RIGHT">
            <styleClass>
                <String fx:value="sell-background"/>
                <String fx:value="bgr-r-20"/>
            </styleClass>
            <StackPane.margin>
                <Insets right="-67.0"/>
            </StackPane.margin>
            <Label fx:id="sellLabel" alignment="CENTER_RIGHT" text="SELL" textFill="WHITE"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.topAnchor="0.0">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
        </AnchorPane>
        <StackPane>
            <ImageView fx:id="cardImage" fitHeight="219.0" fitWidth="165.0" StackPane.alignment="CENTER"/>
        </StackPane>
    </StackPane>
</AnchorPane>
