<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane fx:id="card_AnchorPane" prefHeight="180" prefWidth="120" style="-fx-background-color: transparent;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.balatro.controller.CardViewController">
   <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" percentWidth="5.0" />
         <ColumnConstraints fx:id="imageColumn" halignment="CENTER" hgrow="SOMETIMES" />
       <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" percentWidth="25.0" />
     </columnConstraints>
     <rowConstraints>
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
      
          <Label fx:id="priceLabel" style="-fx-font-size: 14; -fx-text-fill: gold;" GridPane.columnIndex="1" />
      
          <ImageView fx:id="cardImage" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.rowSpan="3" />
      
          <Label fx:id="buyLabel" style="-fx-font-weight: bold; -fx-text-fill: green;" text="BUY" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      
          <Label fx:id="sellLabel" style="-fx-font-weight: bold; -fx-text-fill: red;" text="SELL" visible="false" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      </children>
   </GridPane>
</AnchorPane>
